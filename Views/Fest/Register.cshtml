@model Participant
@{
    ViewData["Title"] = "Register";
    var events = ViewBag.Events as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
}
<div class="page-heading mb-4">
    <span class="eyebrow">JOIN THE FEST</span>
    <h1 class="fw-bold mt-2">Participant registration</h1>
    <p class="text-secondary">Fill in your details to reserve your place.</p>
</div>
<div class="form-card">
    <form asp-controller="Fest" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ParticipantName" class="form-label">Participant name</label>
                <input asp-for="ParticipantName" class="form-control" placeholder="Your full name" />
                <span asp-validation-for="ParticipantName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Department" class="form-label">Department</label>
                <select asp-for="Department" class="form-select">
                    <option value="">Select department</option>
                    <option>CSE</option><option>IT</option><option>EC</option><option>Mechanical</option><option>Civil</option><option>Other</option>
                </select>
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Year" class="form-label">Academic year</label>
                <select asp-for="Year" class="form-select">
                    <option value="">Select year</option>
                    <option>First Year</option><option>Second Year</option><option>Third Year</option><option>Fourth Year</option>
                </select>
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="EventName" class="form-label">Event</label>
                <select asp-for="EventName" class="form-select">
                    <option value="">Choose an event</option>
                    @foreach (var festEvent in events)
                    {
                        <option value="@festEvent.Key">@festEvent.Key — @(festEvent.Value == 0 ? "Free" : $"₹{festEvent.Value}")</option>
                    }
                </select>
                <span asp-validation-for="EventName" class="text-danger small"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end pb-2">
                <div class="form-check">
                    <input asp-for="IsTeamEvent" class="form-check-input" />
                    <label asp-for="IsTeamEvent" class="form-check-label">Team event</label>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">Submit registration</button>
            <a asp-controller="Fest" asp-action="Index" class="btn btn-outline-secondary">View participants</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
