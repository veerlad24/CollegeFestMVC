@{
    ViewData["Title"] = "Welcome";
}
<section class="hero-panel p-4 p-md-5 rounded-4">
    <span class="eyebrow">AMTICS · COLLEGE TECHNICAL FEST</span>
    <h1 class="display-4 fw-bold mt-3">Ideas become <span class="brand-accent">innovation.</span></h1>
    <p class="lead mt-3 col-lg-8">Bring your curiosity, meet fellow creators, and take on exciting technical challenges. Register for an event and be part of the fest.</p>
    <div class="d-flex flex-wrap gap-3 mt-4">
        <a class="btn btn-light btn-lg fw-semibold" asp-controller="Fest" asp-action="Register">Register now</a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Fest" asp-action="Index">View participants</a>
    </div>
</section>
<div class="row g-3 mt-3">
    <div class="col-md-4"><div class="info-card h-100"><h5>Code Sprint</h5><p class="mb-0">Solve problems and think fast. Registration fee: Free.</p></div></div>
    <div class="col-md-4"><div class="info-card h-100"><h5>Web Design Challenge</h5><p class="mb-0">Turn a creative concept into a polished web experience.</p></div></div>
    <div class="col-md-4"><div class="info-card h-100"><h5>Robotics Arena</h5><p class="mb-0">Explore engineering, automation, and teamwork.</p></div></div>
</div>
