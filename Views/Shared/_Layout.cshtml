<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AMTICS TechFest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark fest-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Fest" asp-action="Welcome">AMTICS <span class="brand-accent">TECHFEST</span></a>
            <div class="navbar-nav ms-auto flex-row gap-3">
                <a class="nav-link" asp-controller="Fest" asp-action="Index">Participants</a>
                <a class="nav-link" asp-controller="Fest" asp-action="Register">Register</a>
                <a class="nav-link" asp-controller="Fest" asp-action="Welcome">Welcome</a>
            </div>
        </div>
    </nav>
    <main class="container py-4 py-md-5">
        @RenderBody()
    </main>
    <footer class="container text-center text-secondary small pb-4">AMTICS College Technical Fest · Learn, build, innovate.</footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
